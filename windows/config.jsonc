{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/Pictures/ryoemblems/loli.png",
    "width": 28,
    "height": 14,
    "padding": {
      "left": 3,
      "right": 5,
      "top": 5
    }
  },
  "display": {
    "color": {
      "keys": "38;2;255;105;180",
      "separator": "#8f8770",
      "title": "38;2;107;182;255"
    },
    "key": {
      "width": 10
    },
    "percent": {
      "color": {
        "green": "#7fbf6a",
        "red": "#e2342a",
        "yellow": "#d9a441"
      },
      "type": 9
    },
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;title}♡ {user-name}{#} {#separator}@{#} {#1;title}{host-name} ♡{#}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;255;105;180m✦\u001b[0m \u001b[38;2;107;182;255mryoku · 力 · a hand-built desktop\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;255;182;193m✿ ♡ ✿ ♡ ✿ ♡ ✿ ♡ ✿ ♡ ✿ ♡ ✿\u001b[0m"
    },
    "break",
    {
      "key": "✿ OS",
      "type": "os"
    },
    {
      "key": "♡ Kernel",
      "type": "kernel"
    },
    {
      "key": "✦ WM",
      "type": "wm"
    },
    {
      "key": "⋆ Shell",
      "type": "shell"
    },
    {
      "key": "˚ Term",
      "type": "terminal"
    },
    "break",
    {
      "key": "♥ Uptime",
      "type": "uptime"
    },
    {
      "key": "∿ Memory",
      "type": "memory"
    },
    {
      "key": "◆ Disk",
      "type": "disk"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;255;105;180m♡ have a cute day ♡\u001b[0m"
    },
    "break"
  ]
}
